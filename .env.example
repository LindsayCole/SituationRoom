# Yahoo Developer credentials. Keep these server-side only.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must exactly match the callback configured in Yahoo Developer Network.
# For local use, this default is convenient:
APP_ORIGIN=http://127.0.0.1:8787
YAHOO_REDIRECT_URI=http://127.0.0.1:8787/api/yahoo/callback

# Generate a long random value and keep it secret.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YAHOO_TOKEN_ENCRYPTION_KEY=

# Yahoo Fantasy access is read-only by default as of 2026.
# Leave false unless Yahoo has explicitly approved read/write access for the app.
YAHOO_WRITE_ENABLED=false

HOST=127.0.0.1
PORT=8787
